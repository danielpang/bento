{
  "name": "@bento/desktop",
  "version": "0.0.1",
  "private": true,
  "license": "Elastic-2.0",
  "description": "Bento for macOS",
  "author": "Bento",
  "type": "module",
  "main": "dist/main.js",
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "test": "node --test --import tsx src/*.test.ts",
    "test:e2e": "node scripts/smoke.mjs",
    "test:auth": "node scripts/remote-smoke.mjs",
    "package:mac": "node scripts/package.mjs"
  },
  "dependencies": {
    "@bento/api-client": "workspace:*",
    "@bento/sandbox": "workspace:*",
    "@bento/server": "workspace:*"
  },
  "devDependencies": {
    "@bento/web": "workspace:*",
    "@types/node": "^26.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
