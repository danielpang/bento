    "@bento/core": "workspace:*",
    "@bento/sandbox": "workspace:*",
    "@bento/server": "workspace:*",
    "ink": "^7.1.1",
    "react": "^19.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.10",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
