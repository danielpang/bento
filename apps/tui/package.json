{
  "name": "@bento/tui",
  "version": "0.0.1",
  "private": true,
  "license": "Elastic-2.0",
  "type": "module",
  "bin": {
    "bento": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
