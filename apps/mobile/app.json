{
  "expo": {
    "name": "Bento",
    "slug": "bento-mobile",
    "scheme": "bento",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "ai.usebento.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "icon": "../../assets/brand/logo.png"
  }
}
