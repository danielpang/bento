# Copy to .env and adjust.

# local = single user, binds 127.0.0.1, auth UI hidden, auto login
# multi = full auth (email/password + Google + GitHub)
BENTO_MODE=local

PORT=4400
DATABASE_URL=postgres://postgres:postgres@localhost:5439/app

# Where worktrees and server state live
BENTO_DATA_DIR=~/.bento

# docker = isolated containers (build it with:
#   docker build -t bento-sandbox:dev infra/sandbox-image)
# sprite = Fly.io Sprites, for hosted deployments
# local-process = no isolation, for development and CI only
BENTO_SANDBOX_DRIVER=docker
BENTO_SANDBOX_IMAGE=bento-sandbox:dev

# Required when BENTO_SANDBOX_DRIVER=sprite
SPRITES_TOKEN=
SPRITES_REGION=

# How many agent runs this process drives at once. 4 is right for a
# laptop running Docker sandboxes. Hosted Fly sets 32.
BENTO_MAX_CONCURRENT_RUNS=4

# How long one agent run may execute before it is stopped, in minutes
BENTO_RUN_TIMEOUT_MIN=120

# After a live agent (pi, Claude Code) finishes a turn on a manual
# stage, seconds to keep the process open for another message. 0 closes
# as soon as the queue is empty. Automatic stages ignore this.
BENTO_LIVE_IDLE_SEC=90

# Agent credentials, forwarded into sandboxes per run.
# Mounting subscription credential files instead of keys is opt in and
# riskier: a prompt-injected agent could read them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CURSOR_API_KEY=

# Claude subscription instead of an API key. Mint a long lived token
# once with: claude setup-token. Counts as a credential the same way a
# key does. This is the route for a server running in a container,
# which cannot reach this machine's keychain.
CLAUDE_CODE_OAUTH_TOKEN=

# S3-compatible bucket for binary run artifacts (screenshots, HTML
# previews an agent leaves for the card). All four are needed together.
# On Fly, `fly storage create` provisions Tigris and injects the
# equivalent AWS_* and BUCKET_NAME variables, which are read as
# fallbacks, so a Tigris deployment can leave these empty. Local mode
# stores artifact files under BENTO_DATA_DIR instead; multi mode with
# no bucket keeps text artifacts only and says so at boot.
BENTO_ARTIFACTS_BUCKET=
BENTO_ARTIFACTS_ENDPOINT=
BENTO_ARTIFACTS_ACCESS_KEY_ID=
BENTO_ARTIFACTS_SECRET_ACCESS_KEY=
BENTO_ARTIFACTS_REGION=

# Lets stages with "Create a pull request" enabled push the feature
# branch and open the pull request, without installing the GitHub App.
# Use a fine grained personal access token with contents and pull
# request write access. The server keeps it: unlike the keys above it
# is never forwarded into an agent's sandbox.
GITHUB_TOKEN=

# Whether an address must be confirmed before an account can sign in.
# Unset follows whether SMTP is configured below: a hosted deployment
# gets the gate, and a laptop install without mail does not lock itself
# out behind a link it cannot send.
# An optional deployment extension, loaded at startup in multi mode.
# The open source server has no plans and no billing: it exposes an
# Entitlements interface (see apps/server/src/context.ts) that this
# module fills in, plus routes under /api/billing. Points at a built
# module, for example ../bento-cloud/dist/index.js. Leave empty and
# every limit check passes, which is the open source behaviour.
BENTO_CLOUD_MODULE=

# Brute force protection on the auth endpoints, counted in Postgres so
# the limit holds across instances. On by default in multi mode.
BENTO_RATE_LIMIT=

BENTO_REQUIRE_EMAIL_VERIFICATION=

# A Docker network with no route out, for organizations that turn on
# "Block network access" under Team. The egress rules live on the
# network, so create it yourself, for example:
#   docker network create --internal bento-locked
# Without this the setting cannot be turned on, and an organization
# that already has it on refuses to start agents rather than running
# them with open egress.
BENTO_SANDBOX_RESTRICTED_NETWORK=

# Only read by docker compose, for the full container stack.
# Where your checkouts live; mounted into the server container at the
# same path so sandboxes can see them.
BENTO_REPOS=
# Commit attribution for agents, since the container has no gitconfig.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# SMTP for account email: invitations, address confirmation, password
# resets, and account deletion. Without SMTP_HOST every link is written
# to the server log instead, so you can pass it on by hand, and address
# confirmation stays off so nobody is locked out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Implicit TLS. Defaults to true on port 465, STARTTLS elsewhere.
SMTP_SECURE=
BENTO_MAIL_FROM=Bento <no-reply@example.com>

# Where the in-app contact form (issue reports and feature requests)
# delivers its mail. Unset, the form tells people contact is not
# configured on this server.
BENTO_CONTACT_EMAIL=

# Encrypts organization agent keys at rest. Required in multi mode.
#   openssl rand -hex 32
BENTO_SECRET_KEY=

# Serve the built web console from the API origin. Leave unset in
# development, where Vite serves it and proxies /api to this server.
BENTO_WEB_DIR=

# Share this machine's agent logins (Claude, Codex, Cursor, opencode, pi)
# with sandboxes, so a subscription works without an API key. Local mode
# only, ignored in multi mode. Off by default: these are long lived
# credentials and an agent can read anything its sandbox can.
BENTO_SHARE_AGENT_AUTH=false

# GitHub App, for the pr_comments_resolved and checks_pass gate criteria.
# Without these, PR based criteria stay pending instead of passing.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Slack app, for @bento mentions and thread progress. Create an app at
# api.slack.com/apps, then set the redirect URL to
# $BETTER_AUTH_URL/api/slack/callback and the Events / Interactivity
# URLs to $BETTER_AUTH_URL/api/webhooks/slack/events and
# $BETTER_AUTH_URL/api/webhooks/slack/interactive. See docs/slack.md.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Required in multi mode. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4400

# Social login (multi mode). Each provider appears on the sign in page
# only when both halves are set. These are the client credentials, which
# are not the GitHub App identifiers above even when one app serves both.
#
# The GitHub pair does more than sign people in: connecting the App is
# only allowed for someone GitHub already shows the installation to, and
# these are what let an account made with an email and a password attach
# a GitHub account to prove it. Take them from the same App configured
# above. Without them, nobody on this deployment can install it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# PostHog: product analytics, error tracking, and log export. All three
# read the same project token (phc_..., from the project settings page).
# Leave the key empty and nothing is sent; outside production the server
# says so once at boot.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Personal API key (phx_...) and numeric project id, used only by
# apps/server/scripts/upsert-agent-spend-dashboard.ts to create the
# Agent spend dashboard. The server does not read these.
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=

# Stamped as the environment property on every PostHog event, error,
# and log record. The Docker image sets production; everything else
# defaults to development.
BENTO_ENVIRONMENT=development
